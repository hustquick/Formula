{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formula OCR benchmark sample manifest (planned)",
  "type": "object",
  "required": ["schemaVersion", "samples"],
  "properties": {
    "schemaVersion": {"const": 1},
    "samples": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "groupId", "categories", "input", "rights", "gold"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "groupId": {"type": "string", "minLength": 1},
        "categories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "input": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "page1Based": {"type": "integer", "minimum": 1}, "generation": {"type": "object"}}},
        "rights": {"type": "object", "required": ["author", "source", "license", "redistributionApproved"], "properties": {"author": {"type": "string"}, "source": {"type": "string"}, "license": {"type": "string"}, "redistributionApproved": {"const": true}}},
        "gold": {"type": "array", "items": {"type": "object", "required": ["id", "language", "source", "reviewed"], "properties": {"id": {"type": "string"}, "language": {"enum": ["latex", "typst"]}, "source": {"type": "string"}, "reviewed": {"const": true}, "region": {"type": "object", "required": ["coordinateSpace", "bbox"], "properties": {"coordinateSpace": {"enum": ["image-pixels", "pdf-points"]}, "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}}}}}}
      }
    }}
  }
}
